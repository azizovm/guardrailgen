        "ymax": -1.6
      }
    },
    "supported_variables": [
      "state.x",
      "state.y",
      "state.heading",
      "command.linear_speed",
      "command.angular_speed",
      "command.duration"
    ]
  },
  "stl": "((not (region_kitchen >= 0)) or ((command_linear_speed <= 0.1) and (command_linear_speed >= -0.1)))",
