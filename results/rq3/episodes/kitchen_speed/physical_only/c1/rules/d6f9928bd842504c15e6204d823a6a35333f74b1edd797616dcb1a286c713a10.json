  "rule": {
    "schema_version": "1.0",
    "id": "kitchen-speed-limit",
    "text": "In the kitchen, keep the commanded linear speed at or below 0.1 m/s in both directions.",
    "expression": {
      "op": "or",
      "args": [
        {
          "op": "not",
          "arg": {
            "op": "inside",
            "region": "kitchen"
          }
        },
        {
          "op": "and",
          "args": [
            {
              "op": "compare",
              "variable": "command.linear_speed",
              "comparator": "le",
              "value": 0.1,
              "unit": "m/s"
            },
            {
              "op": "compare",
              "variable": "command.linear_speed",
              "comparator": "ge",
              "value": -0.1,
              "unit": "m/s"
            }
          ]
        }
      ]
    }
  },
  "scenario": {
    "schema_version": "1.0",
    "frame": "odom",
